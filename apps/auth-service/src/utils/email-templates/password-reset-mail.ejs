<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="light dark" />
    <meta name="supported-color-schemes" content="light dark" />
    <title>Reset Your Password - OTP</title>

    <style>
      /* Dark mode support (Apple Mail, some Gmail, others) */
      @media (prefers-color-scheme: dark) {
        body {
          background-color: #0f172a !important;
        }

        .container {
          background-color: #020617 !important;
        }

        .text {
          color: #e5e7eb !important;
        }

        .muted {
          color: #9ca3af !important;
        }

        .otp-box {
          background-color: #020617 !important;
          border-color: #6366f1 !important;
        }

        .warning {
          background-color: #1f2933 !important;
          color: #fbbf24 !important;
        }

        .footer {
          color: #9ca3af !important;
        }
      }
    </style>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f6f8;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
      <tr>
        <td align="center" style="padding: 40px 12px">
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            role="presentation"
            class="container"
            style="
              max-width: 500px;
              background-color: #ffffff;
              border-radius: 8px;
              padding: 32px;
              box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            "
          >
            <tr>
              <td>
                <h2
                  class="text"
                  style="margin: 0 0 12px; color: #111827; font-size: 22px"
                >
                  Hello <%= name %>,
                </h2>

                <p
                  class="text"
                  style="
                    margin: 0 0 20px;
                    color: #374151;
                    font-size: 15px;
                    line-height: 1.5;
                  "
                >
                  We received a request to reset your
                  <strong>majehub</strong> user account password. Use the One-Time
                  Password (OTP) below to continue.
                </p>

                <!-- OTP Box -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  role="presentation"
                  class="otp-box"
                  style="
                    background-color: #f0f4ff;
                    border: 1px dashed #4f46e5;
                    border-radius: 6px;
                    margin-bottom: 20px;
                  "
                >
                  <tr>
                    <td align="center" style="padding: 16px">
                      <p
                        class="muted"
                        style="margin: 0 0 6px; font-size: 13px; color: #4b5563"
                      >
                        Your Password Reset OTP
                      </p>

                      <p
                        style="
                          margin: 0;
                          font-size: 28px;
                          font-weight: bold;
                          letter-spacing: 6px;
                          color: #4f46e5;
                        "
                      >
                        <%= otp %>
                      </p>

                      <p
                        class="muted"
                        style="margin: 8px 0 0; font-size: 12px; color: #6b7280"
                      >
                        (Tap or drag to copy)
                      </p>
                    </td>
                  </tr>
                </table>

                <!-- Warning -->
                <table
                  width="100%"
                  cellpadding="0"
                  cellspacing="0"
                  role="presentation"
                  class="warning"
                  style="
                    background-color: #fff7ed;
                    border-left: 4px solid #f97316;
                    margin-bottom: 16px;
                  "
                >
                  <tr>
                    <td style="padding: 12px">
                      <p
                        style="
                          margin: 0;
                          font-size: 14px;
                          color: #7c2d12;
                          line-height: 1.5;
                        "
                      >
                        ⚠️ This OTP will expire in
                        <strong>5 minutes</strong>. Do not share this code with
                        anyone.
                      </p>
                    </td>
                  </tr>
                </table>

                <p
                  class="text"
                  style="
                    margin: 0;
                    color: #4b5563;
                    font-size: 14px;
                    line-height: 1.5;
                  "
                >
                  If you did not request a password reset, you can safely ignore
                  this email.
                </p>

                <hr
                  style="
                    border: none;
                    border-top: 1px solid #e5e7eb;
                    margin: 24px 0;
                  "
                />

                <p
                  class="footer"
                  style="
                    margin: 0;
                    font-size: 12px;
                    color: #9ca3af;
                    text-align: center;
                  "
                >
                  © <%= new Date().getFullYear() %> majehub. All rights
                  reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
