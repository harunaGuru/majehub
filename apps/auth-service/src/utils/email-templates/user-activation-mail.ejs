<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Your OTP Code</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      background-color: #f4f6f8;
      font-family: Arial, Helvetica, sans-serif;
    "
  >
    <table width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center" style="padding: 40px 0">
          <table
            width="100%"
            max-width="500"
            cellpadding="0"
            cellspacing="0"
            style="
              background: #ffffff;
              border-radius: 8px;
              padding: 32px;
              box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
            "
          >
            <tr>
              <td>
                <h2 style="margin: 0 0 12px; color: #222">
                  Hello <%= name %>,
                </h2>

                <p style="margin: 0 0 20px; color: #555; font-size: 15px">
                  Thank you for registering with Majehub. To activate your account, please use the One-Time Password (OTP) below to complete your
                  verification.
                </p>

                <!-- OTP Box -->
                <div
                  style="
                    background: #f0f4ff;
                    border: 1px dashed #4f46e5;
                    padding: 16px;
                    text-align: center;
                    border-radius: 6px;
                    margin-bottom: 20px;
                  "
                >
                  <p style="margin: 0 0 6px; font-size: 13px; color: #555">
                    Your OTP
                  </p>

                  <p
                    style="
                      margin: 0;
                      font-size: 28px;
                      font-weight: bold;
                      letter-spacing: 6px;
                      color: #4f46e5;
                      user-select: all;
                    "
                  >
                    <%= otp %>
                  </p>

                  <p style="margin: 8px 0 0; font-size: 12px; color: #777">
                    (Tap or drag to copy)
                  </p>
                </div>

                <!-- Warning -->
                <p
                  style="
                    margin: 0 0 16px;
                    padding: 12px;
                    background: #fff7ed;
                    border-left: 4px solid #f97316;
                    color: #7c2d12;
                    font-size: 14px;
                  "
                >
                  ⚠️ This OTP will expire in <strong>5 minutes</strong>. Do not
                  share this code with anyone.
                </p>

                <p style="margin: 0; color: #666; font-size: 14px">
                  If you didn’t request this code, please ignore this email.
                </p>

                <hr
                  style="
                    border: none;
                    border-top: 1px solid #eee;
                    margin: 24px 0;
                  "
                />

                <p style="margin: 0; font-size: 12px; color: #999">
                  © <%= new Date().getFullYear() %> Majehub. All rights
                  reserved.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
